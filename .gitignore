# ---- build output ------------------------------------------------------
artifacts/
dist/
bin/
obj/
[Bb]uild/[Bb]in/
*.pdb

# ---- installer staging -------------------------------------------------
# build-installer.ps1 regenerates both of these; the payload zips alone are
# ~32 MB and would otherwise land in every clone.
installer/AB.RevitMcp.Setup/payload/
installer/AB.RevitMcp.Setup/lib/
*.allowlist.txt

# ---- code signing ------------------------------------------------------
# Never commit a signing certificate or its password.
*.pfx
*.p12
*.snk

# ---- IDE / tooling -----------------------------------------------------
.vs/
.vscode/
.idea/
*.user
*.suo
*.DotSettings.user

# ---- scratch -----------------------------------------------------------
.testout/
*.log

# ---- promo / marketing assets (not part of the product) ----
.promo/
