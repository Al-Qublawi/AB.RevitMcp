<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net48 on purpose. The installer must run on a machine that has never had .NET installed,
      and .NET Framework 4.8 is present on every supported version of Windows - Revit itself
      requires it. A .NET 8 installer would need its own runtime bundled just to start.
    -->
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>AB.RevitMcp.Setup</AssemblyName>
    <RootNamespace>AB.RevitMcp.Setup</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblyTitle>AB Revit MCP Bridge Setup</AssemblyTitle>
    <Product>AB Revit MCP Bridge</Product>
    <Company>Abdullah Lotfy</Company>
    <Authors>Abdullah Lotfy</Authors>
    <Copyright>Copyright (c) Abdullah Lotfy</Copyright>
    <Description>Installs the AB Revit MCP Bridge add-in and MCP server for Autodesk Revit 2020-2026.</Description>
    <Version>1.3.0</Version>
    <DebugType>none</DebugType>
    <ApplicationIcon>Resources\logo.ico</ApplicationIcon>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\$(Configuration)\Setup\</OutputPath>
  </PropertyGroup>

  <!--
    The shared contracts assembly rides along purely for its JSON parser: merging a new server
    entry into an existing claude_desktop_config.json has to preserve every other setting, and
    hand-rolled string surgery on someone's config file is not acceptable.
  -->
  <ItemGroup>
    <!--
      Referenced from a staged copy rather than as a ProjectReference, and embedded rather than
      copied, so the finished installer really is ONE file. build-installer.ps1 stages
      lib\AB.RevitMcp.Contracts.dll (the net48 build); Program.cs resolves it out of resources at
      startup. Private=false keeps it out of the output folder.
    -->
    <Reference Include="AB.RevitMcp.Contracts">
      <HintPath>lib\AB.RevitMcp.Contracts.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="Exists('lib\AB.RevitMcp.Contracts.dll')">
    <EmbeddedResource Include="lib\AB.RevitMcp.Contracts.dll">
      <LogicalName>AB.RevitMcp.Setup.Lib.AB.RevitMcp.Contracts.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Product artwork shown in the setup window and used as the window icon. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\logo_96.png">
      <LogicalName>AB.RevitMcp.Setup.Resources.logo_96.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\logo.ico">
      <LogicalName>AB.RevitMcp.Setup.Resources.logo.ico</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <!-- Interaction.InputBox: a one-line prompt without hand-building a dialog. -->
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <!--
    One zip per Revit release plus the server travel inside this executable, so the installer is a
    single file you can copy to any machine. build-installer.ps1 fills payload\; this target embeds
    whatever it finds, so adding a Revit release needs no change here.
  -->
  <Target Name="EmbedPayload" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <PayloadZip Include="payload\*.zip" />
      <EmbeddedResource Include="@(PayloadZip)">
        <LogicalName>AB.RevitMcp.Setup.Payload.%(Filename).zip</LogicalName>
      </EmbeddedResource>
    </ItemGroup>

    <Warning Condition="'@(PayloadZip)' == ''"
             Text="No payload zips found in installer\AB.RevitMcp.Setup\payload. Build with build\build-installer.ps1, not directly." />
  </Target>

</Project>
