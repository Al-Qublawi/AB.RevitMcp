<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net48 on purpose. The installer must run on a machine that has never had .NET installed,
      and .NET Framework 4.8 is present on every supported version of Windows - Revit itself
      requires it. A .NET 8 installer would need its own runtime bundled just to start.

      The window, earlier-version detection and removal, Apps and Features registration and
      silent mode come from the AB Adv Tools installer engine (shared\ABAdvTools); this project
      adds what is specific to the bridge in RevitMcpSetup.cs. Version: Directory.Build.props.
    -->
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>AB.RevitMcp.Setup</AssemblyName>
    <RootNamespace>AB.RevitMcp.Setup</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblyTitle>AB Revit MCP Bridge Setup</AssemblyTitle>
    <Description>Installs the AB Revit MCP Bridge add-in and MCP server for Autodesk Revit.</Description>
    <DebugType>none</DebugType>
    <ApplicationIcon>Resources\logo.ico</ApplicationIcon>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\$(Configuration)\Setup\</OutputPath>

    <ABAdvToolsProductLogo>Resources\logo_96.png</ABAdvToolsProductLogo>
  </PropertyGroup>

  <Import Project="..\..\shared\ABAdvTools\build\ABAdvTools.Setup.targets" />

  <!--
    The shared contracts assembly rides along purely for its JSON parser: merging a new server
    entry into an existing claude_desktop_config.json has to preserve every other setting, and
    hand-rolled string surgery on someone's config file is not acceptable.
  -->
  <ItemGroup>
    <!--
      Referenced from a staged copy rather than as a ProjectReference, and embedded rather than
      copied, so the finished installer really is ONE file. build-installer.ps1 stages
      lib\AB.RevitMcp.Contracts.dll (the net48 build); Program.cs resolves it out of resources at
      startup. Private=false keeps it out of the output folder.
    -->
    <Reference Include="AB.RevitMcp.Contracts">
      <HintPath>lib\AB.RevitMcp.Contracts.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="Exists('lib\AB.RevitMcp.Contracts.dll')">
    <EmbeddedResource Include="lib\AB.RevitMcp.Contracts.dll">
      <LogicalName>AB.RevitMcp.Setup.Lib.AB.RevitMcp.Contracts.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <!-- Interaction.InputBox: a one-line prompt without hand-building a dialog. -->
    <Reference Include="Microsoft.VisualBasic" />
  </ItemGroup>

</Project>
