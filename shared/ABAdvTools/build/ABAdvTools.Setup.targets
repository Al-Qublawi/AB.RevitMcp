<Project>

  <!--
    AB Adv Tools installer engine for a setup executable project. In the .csproj:

        <PropertyGroup>
          <ABAdvToolsProductLogo>..\..\assets\logo_128.png</ABAdvToolsProductLogo>
        </PropertyGroup>
        <Import Project="..\..\shared\ABAdvTools\build\ABAdvTools.Setup.targets" />

    and a payload\ folder beside the project, filled by the build script with one zip per
    installable unit (e.g. Revit2024.zip, Navisworks2026.zip). Every zip found is embedded, so
    adding an Autodesk release needs no project change.
  -->

  <PropertyGroup>
    <ABAdvToolsKitRoot>$(MSBuildThisFileDirectory)..\</ABAdvToolsKitRoot>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- 64-bit on 64-bit Windows: Program Files and HKLM must be the real, unredirected ones. -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationManifest>$(ABAdvToolsKitRoot)build\setup.manifest</ApplicationManifest>
    <DefineConstants>$(DefineConstants);ABADVTOOLS_SETUP</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(ABAdvToolsKitRoot)src\Common\**\*.cs" LinkBase="ABAdvTools\Common" />
    <Compile Include="$(ABAdvToolsKitRoot)src\Setup\**\*.cs" LinkBase="ABAdvTools\Setup" />
  </ItemGroup>

  <!-- Optional terms / read-me page before installing: <ABAdvToolsLicense>License.rtf</ABAdvToolsLicense> -->
  <ItemGroup Condition="'$(ABAdvToolsLicense)' != ''">
    <EmbeddedResource Include="$(ABAdvToolsLicense)" LogicalName="ABAdvTools.Assets.license.rtf" />
  </ItemGroup>

  <ItemGroup Condition="'$(ABAdvToolsProductLogo)' != ''">
    <EmbeddedResource Include="$(ABAdvToolsProductLogo)" LogicalName="ABAdvTools.Assets.product_logo.png" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <Target Name="ABAdvToolsEmbedPayload" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <_ABAdvToolsPayload Include="$(MSBuildProjectDirectory)\payload\*.zip" />
      <EmbeddedResource Include="@(_ABAdvToolsPayload)">
        <LogicalName>ABAdvTools.Payload.%(Filename).zip</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
    <Warning Condition="'@(_ABAdvToolsPayload)' == ''"
             Text="No payload zips in $(MSBuildProjectDirectory)\payload. Build the installer with its build script, not directly." />
  </Target>

</Project>
