<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ============================================================================
     Revit add-in - multi-targeted across the .NET runtime transition
    ============================================================================
       Revit 2020 - 2024   .NET Framework 4.8      -> net48
       Revit 2025 - 2027   .NET 8 (Windows)        -> net8.0-windows

     Build one specific release:
       dotnet build -c Release -f net48          -p:RevitVersion=2022
       dotnet build -c Release -f net8.0-windows -p:RevitVersion=2026

     build/build-all.ps1 loops the whole matrix.
  -->

  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <RootNamespace>AB.RevitMcp.Addin</RootNamespace>
    <AssemblyName>AB.RevitMcp.Addin</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
  </PropertyGroup>

  <!-- Default Revit release per runtime. Override on the command line. -->
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == '' and '$(TargetFramework)' == 'net48'">2024</RevitVersion>
    <RevitVersion Condition="'$(RevitVersion)' == '' and '$(TargetFramework)' == 'net8.0-windows'">2026</RevitVersion>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2024</RevitVersion>
    <RevitApiDir Condition="'$(RevitApiDir)' == ''">$(RevitProgramRoot)\Revit $(RevitVersion)</RevitApiDir>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\$(Configuration)\Revit$(RevitVersion)\</OutputPath>

    <!--
      Where the Revit API metadata comes from. Packages by default; set this to false (or pass
      -p:UseRevitApiPackages=false) to compile against the DLLs in a local Revit install instead.

      Packages are the default because compiling against an INSTALLED Revit ties the build to
      whatever update Autodesk last pushed to the build machine. Revit 2026 update 26.5 is exactly
      that trap: it is built against .NET 10, so a net8 project can no longer reference it at all -

        error CS1705: Assembly 'RevitAPI' ... uses 'System.Runtime, Version=10.0.0.0' which has a
        higher version than referenced assembly 'System.Runtime, Version=8.0.0.0'

      and the add-in became unbuildable on an up-to-date machine, for no reason connected to our
      code. The pinned 2026.4.10 reference assemblies still target net8.0-windows7.0, and the
      resulting binary loads happily under 26.5 - verified against a live 26.5.0.55 session -
      because .NET stayed backward compatible. Targeting net10 instead would only break everyone
      still on 26.4.
    -->
    <UseRevitApiPackages Condition="'$(UseRevitApiPackages)' == ''">true</UseRevitApiPackages>

    <!--
      The runtime this Revit release actually uses. Restore walks EVERY entry in TargetFrameworks,
      not just the one being built, so without this the net48 pass would try to resolve the net8
      2026 package and fail restore before a single file compiled:
        NU1202: Package ... 2026.4.10 is not compatible with net48
      Gating the PackageReference on this keeps each release's package on the one framework that
      can consume it.
    -->
    <RevitTargetFramework Condition="'$(RevitVersion)' &gt;= '2025'">net8.0-windows</RevitTargetFramework>
    <RevitTargetFramework Condition="'$(RevitVersion)' &lt; '2025'">net48</RevitTargetFramework>

    <!-- Revit release -> pinned reference-assembly package version. -->
    <RevitApiPackageVersion Condition="'$(RevitVersion)' == '2020'">2020.2.60</RevitApiPackageVersion>
    <RevitApiPackageVersion Condition="'$(RevitVersion)' == '2021'">2021.1.50</RevitApiPackageVersion>
    <RevitApiPackageVersion Condition="'$(RevitVersion)' == '2022'">2022.1.80</RevitApiPackageVersion>
    <RevitApiPackageVersion Condition="'$(RevitVersion)' == '2023'">2023.1.90</RevitApiPackageVersion>
    <RevitApiPackageVersion Condition="'$(RevitVersion)' == '2024'">2024.3.60</RevitApiPackageVersion>
    <RevitApiPackageVersion Condition="'$(RevitVersion)' == '2025'">2025.4.60</RevitApiPackageVersion>
    <RevitApiPackageVersion Condition="'$(RevitVersion)' == '2026'">2026.4.10</RevitApiPackageVersion>

    <!--
      AppendTargetFrameworkToOutputPath=false above applies to the INTERMEDIATE path too, so both
      target frameworks would otherwise generate into the same obj\$(Configuration) folder and
      clobber each other's AssemblyInfo.cs. That only breaks when the two TFMs build together
      (a plain `dotnet build`), which makes it exactly the kind of bug that hides until CI.
      Keep the intermediate output separated per framework and per Revit release.
    -->
    <IntermediateOutputPath>obj\$(Configuration)\$(TargetFramework)\Revit$(RevitVersion)\</IntermediateOutputPath>
  </PropertyGroup>

  <!--
    Version gates for the Revit API breaking changes we actually have to handle:
      2021+  ForgeTypeId / UnitTypeId replace DisplayUnitType
      2022+  Definition.GetDataType() replaces GetSpecTypeId(); Floor.Create(...) replaces NewFloor
      2023+  Category.BuiltInCategory property
      2024+  ElementId.Value (long) replaces ElementId.IntegerValue; Document.GetUnusedElements
      2025+  .NET 8 runtime
  -->
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
    <DefineConstants Condition="'$(RevitVersion)' &gt;= '2021'">$(DefineConstants);REVIT2021_OR_GREATER</DefineConstants>
    <DefineConstants Condition="'$(RevitVersion)' &gt;= '2022'">$(DefineConstants);REVIT2022_OR_GREATER</DefineConstants>
    <DefineConstants Condition="'$(RevitVersion)' &gt;= '2023'">$(DefineConstants);REVIT2023_OR_GREATER</DefineConstants>
    <DefineConstants Condition="'$(RevitVersion)' &gt;= '2024'">$(DefineConstants);REVIT2024_OR_GREATER</DefineConstants>
    <DefineConstants Condition="'$(RevitVersion)' &gt;= '2025'">$(DefineConstants);REVIT2025_OR_GREATER</DefineConstants>
    <DefineConstants Condition="'$(RevitVersion)' &gt;= '2026'">$(DefineConstants);REVIT2026_OR_GREATER</DefineConstants>
    <DefineConstants Condition="'$(RevitVersion)' &gt;= '2027'">$(DefineConstants);REVIT2027_OR_GREATER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AB.RevitMcp.Contracts\AB.RevitMcp.Contracts.csproj" />
    <ProjectReference Include="..\AB.RevitMcp.Ipc\AB.RevitMcp.Ipc.csproj" />
  </ItemGroup>

  <!--
    Revit metadata, from pinned reference-assembly packages. These ship only ref/ assemblies, so
    nothing lands in the output: Revit loads its own copies at runtime, and shipping a second one
    is a guaranteed type-identity bug. PrivateAssets/ExcludeAssets make that explicit and stop the
    reference flowing to anything that references this project.
  -->
  <ItemGroup Condition="'$(UseRevitApiPackages)' == 'true' and '$(TargetFramework)' == '$(RevitTargetFramework)'">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitApiPackageVersion)"
                      PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitApiPackageVersion)"
                      PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- Opt-out path: compile against a local Revit install. -->
  <ItemGroup Condition="'$(UseRevitApiPackages)' != 'true'">
    <Reference Include="RevitAPI">
      <HintPath>$(RevitApiDir)\RevitAPI.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitApiDir)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Core" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Manifests\**\*.addin" CopyToOutputDirectory="Never" />
  </ItemGroup>

  <!--
    Author branding rides inside the assembly. Loose icon files beside the add-in would have to be
    copied by the installer into every Revit release folder; embedding keeps that folder to three
    DLLs and removes a whole class of "works on my machine" deployment bug.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\linkedin_16.ico">
      <LogicalName>AB.RevitMcp.Addin.Resources.linkedin_16.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\linkedin_32.ico">
      <LogicalName>AB.RevitMcp.Addin.Resources.linkedin_32.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\logo_16.png">
      <LogicalName>AB.RevitMcp.Addin.Resources.logo_16.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\logo_32.png">
      <LogicalName>AB.RevitMcp.Addin.Resources.logo_32.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="ValidateRevitApi" BeforeTargets="ResolveAssemblyReferences">
    <!-- Using packages: Revit need not be installed at all, but the release must be one we pin. -->
    <Error Condition="'$(UseRevitApiPackages)' == 'true' and '$(RevitApiPackageVersion)' == ''"
           Text="No Revit API package version is pinned for Revit $(RevitVersion). Add one to RevitApiPackageVersion in this file, or build against a local install with -p:UseRevitApiPackages=false." />

    <Error Condition="'$(UseRevitApiPackages)' != 'true' and !Exists('$(RevitApiDir)\RevitAPI.dll')"
           Text="RevitAPI.dll was not found at '$(RevitApiDir)'. Install Revit $(RevitVersion), pass -p:RevitApiDir=&lt;folder containing RevitAPI.dll&gt;, or drop -p:UseRevitApiPackages=false to build from the pinned reference packages." />
    <Error Condition="'$(TargetFramework)' == 'net48' and '$(RevitVersion)' &gt;= '2025'"
           Text="Revit $(RevitVersion) runs on .NET 8. Build it with -f net8.0-windows." />
    <Error Condition="'$(TargetFramework)' == 'net8.0-windows' and '$(RevitVersion)' &lt; '2025'"
           Text="Revit $(RevitVersion) runs on .NET Framework 4.8. Build it with -f net48." />
  </Target>

  <Target Name="ReportRevitTarget" AfterTargets="Build">
    <Message Importance="high" Text="  -> AB.RevitMcp.Addin built for Revit $(RevitVersion) ($(TargetFramework)) into $(OutputPath)" />
  </Target>

</Project>
