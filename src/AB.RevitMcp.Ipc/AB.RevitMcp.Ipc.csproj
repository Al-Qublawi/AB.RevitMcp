<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Multi-targeted because the two runtimes secure a named pipe differently:
        net48           -> PipeSecurity ACL restricted to the current Windows user
        net8.0-windows  -> PipeOptions.CurrentUserOnly (same effect, built in)
    -->
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <RootNamespace>AB.RevitMcp.Ipc</RootNamespace>
    <AssemblyName>AB.RevitMcp.Ipc</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AB.RevitMcp.Contracts\AB.RevitMcp.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Core" />
  </ItemGroup>

</Project>
