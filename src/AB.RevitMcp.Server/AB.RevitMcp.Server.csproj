<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      A standalone console process, deliberately independent of any AI vendor: it speaks
      Model Context Protocol over stdio (or Streamable HTTP) and knows nothing about which model
      is on the other end. net8.0-windows because named pipes to Revit are a Windows-only concern.
    -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>AB.RevitMcp.Server</RootNamespace>
    <AssemblyName>AB.RevitMcp.Server</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseWindowsForms>false</UseWindowsForms>
    <UseWPF>false</UseWPF>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!--
      Build output and PUBLISH output must not share a folder. The installer publishes
      self-contained into artifacts\<cfg>\Server; when a plain `dotnet build` also wrote there it
      dropped a framework-dependent apphost on top and the exe stopped starting with
      "You must install or update .NET to run this application".
    -->
    <OutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\$(Configuration)\Server-build\</OutputPath>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\artifacts\$(Configuration)\Server\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AB.RevitMcp.Contracts\AB.RevitMcp.Contracts.csproj" />
    <ProjectReference Include="..\AB.RevitMcp.Ipc\AB.RevitMcp.Ipc.csproj" />
  </ItemGroup>

  <!--
    Roslyn, for revit_execute_code on Revit 2025+ (which have no C# compiler of their own). It
    lives HERE, in the server's own process, and never in Revit.exe: other add-ins already load
    their own Roslyn into Revit (pyRevit, other bridges), and a second copy there would bind to
    whichever loaded first. The add-in only receives the compiled assembly. Loaded lazily, the
    first time a snippet is compiled.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

</Project>
